# Every variable the app reads, with no values in it.
#
# Committed on purpose — `.gitignore` blocks `.env*` and then makes an
# exception for this one file. It is the list a deployment is checked against,
# so anything added to `process.env` anywhere in the app belongs here too.
#
# The right-hand comments say where each value comes from and whether it
# differs between local development and Vercel.

# --- Database (Supabase) -----------------------------------------------------
# Runtime uses the transaction pooler on :6543 — serverless opens and drops
# connections constantly and the session pooler cannot take that.
DATABASE_URL=
# Migrations use the session pooler on :5432. drizzle-kit runs DDL, which the
# transaction pooler will not carry. Local/CI only; Vercel never needs it.
DIRECT_URL=

# --- GitHub App --------------------------------------------------------------
GITHUB_APP_ID=
# The .pem, base64-encoded, because the key is multi-line and env vars are not.
#   base64 -w0 debtradar.private-key.pem
GITHUB_PRIVATE_KEY_B64=
# Must match the Webhook secret set on the App's settings page.
GITHUB_WEBHOOK_SECRET=

# --- Auth.js -----------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
# The App's OAuth client id and secret — the same App, not a separate OAuth App.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Production only. Auth.js infers the origin from the request on Vercel, which
# makes preview deployments build callback URLs GitHub has never seen. Pinning
# it to the production domain sends every callback to the one registered URL.
AUTH_URL=

# --- Claude ------------------------------------------------------------------
# Read by the Anthropic SDK from the environment; no code passes it explicitly.
ANTHROPIC_API_KEY=

# --- Inngest -----------------------------------------------------------------
# Production only, both from the Inngest dashboard. The Vercel integration
# writes them for you; set them by hand only if you skip it.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Local development only --------------------------------------------------
# Points the SDK at the local `inngest dev` server instead of Inngest Cloud.
# Must NOT be set on Vercel — with it set, production events go nowhere.
INNGEST_DEV=1
# A smee.io channel that forwards GitHub webhooks to localhost. Not on Vercel:
# there the App posts to the deployment directly.
SMEE_URL=

# --- Analytics (optional) ---------------------------------------------------
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. Leave unset locally and
# on previews: the component renders nothing without it, which is what keeps
# development traffic out of the production property.
NEXT_PUBLIC_GA_ID=
